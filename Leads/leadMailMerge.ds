void automation.leadMailMerge(Int lead_id)
{
leadDetails = zoho.crm.getRecordById("Leads",lead_id);
leadEmail = leadDetails.get("Email");
// 	info leadEmail;
if(leadEmail != null)
{
	mailMergeTemplateId = "ivrbb865f2fedecca472c9b2511ae66a4d473";
	getFirstName = leadDetails.get("First_Name");
	getLastName = leadDetails.get("Last_Name");
	getEmail = leadDetails.get("Email");
	getPhone = leadDetails.get("Phone");
	data = Map();
	data.put("id",lead_id);
	data.put("First_Name",getFirstName);
	data.put("Last_Name",getLastName);
	data.put("Email",getEmail);
	data.put("Phone",getPhone);
	param = Map();
	param.put("subject","Welcome to Our Service");
	param.put("merge_data",{"data":data});
	param.put("output_format","inline");
	param.put("recipient_email",leadDetails.get("Email"));
	param.put("from_email","development@evoluz.in");
	mergeResponse = invokeurl
	[
		url :"https://www.zohoapis.in/writer/api/v1/documents/ivrbb865f2fedecca472c9b2511ae66a4d473/merge/email"
		type :POST
		parameters:param
		connection:"create_lead_mail_merge"
	];
	info mergeResponse;
}
}
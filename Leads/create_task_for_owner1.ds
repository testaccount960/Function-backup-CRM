void automation.create_task_for_owner1(String leadId)
{
// Fetch Lead details
leadInfo = zoho.crm.getRecordById("Leads",leadId);
// Proceed only if leadInfo is valid
owner = leadInfo.getJson("Owner");
if(owner != null)
{
	owner_id = leadInfo.getJSON("Owner").getJSON("id");
	taskMap = Map();
	taskMap.put("Subject","Follow-up with Lead");
	taskMap.put("Owner",owner_id);
	taskMap.put("$se_module","Leads");
	// 		taskMap.put("Who_Id", leadId);
	// Assign to Lead Owner
	taskMap.put("What_Id",leadId);
	// 	taskMap.put("$se_module","Leads");
	// Set Due Date
	taskMap.put("Due_Date",zoho.currentdate.addDay(2));
	// Set Reminder time (2 hours from now)
	reminderTime = zoho.currentdate.addHour(2).toTime();
	info reminderTime;
	// Format and add reminder
	taskMap.put("Reminder",{"ALARM":"FREQ=NONE;ACTION=POPUP;TRIGGER=DATE-TIME:" + reminderTime.toString("yyyy-MM-dd'T'HH:mm:ss'-05:00'")});
	// Create Task
	taskResp = zoho.crm.createRecord("Tasks",taskMap);
	info "Task Created: " + taskResp.toString();
}
else
{
	info "Error: Lead Owner ID not found.";
}
}
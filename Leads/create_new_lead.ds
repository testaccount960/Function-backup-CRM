void automation.create_new_lead(String leadId)
{
response = zoho.crm.getRecordById("Leads",leadId);
//	info response;
first_name = response.getJSON("First_Name");
info first_name;
last_name = response.getJSON("Last_Name");
info last_name;
email = response.getJSON("Email");
info email;
phone = response.getJSON("Phone");
info phone;
company = response.getJSON("Company");
info company;
leadInfo = Map();
leadInfo.put("First_Name",first_name);
leadInfo.put("Last_Name",last_name);
leadInfo.put("Email",email);
leadInfo.put("Phone",phone);
leadInfo.put("Company",company);
response = zoho.crm.createRecord("Leads",leadInfo);
info response;

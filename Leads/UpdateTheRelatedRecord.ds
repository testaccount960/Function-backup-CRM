// Fetch lead details using the Lead ID
leadDetails = zoho.crm.getRecordById("Leads",lead_id);
if(leadDetails != null)
{
	// Extract the email address from the lead
	leadEmail = leadDetails.get("Email");
	if(leadEmail != null && leadEmail != "")
	{
		// Prepare the headers for the API call
		header = Map();
		header.put("Authorization","Zoho-oauthtoken " + access_token);
		// Invoke the API to count related Contacts with the same email
		response = invokeurl
		[
			url :"https://www.zohoapis.in/crm/v3/Contacts/search?email=" + leadEmail
			type :GET
			headers:header
			connection:"test_crm"
		];
		// Check the response
		if(response.get("data") != null)
		{
			// Count the number of contacts with the same email
			contactsCount = response.get("data").size();
			// Update the Lead module with the count
			updateFields = Map();
			updateFields.put("Number_of_Guests",contactsCount);
			updateResponse = zoho.crm.updateRecord("Leads",lead_id,updateFields);
			info updateResponse;
		}
	}
}

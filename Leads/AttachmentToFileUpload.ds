leadDetails = zoho.crm.getRecordById("Leads",lead_id);
relatedAttachments = zoho.crm.getRelatedRecords("Attachments","Leads",lead_id);
if(relatedAttachments.size() > 0)
{
	attachmentId = relatedAttachments.get(0).getJSON("id");
	fileResponse = invokeurl
	[
		url :"https://www.zohoapis.in/crm/v7/Leads/" + lead_id + "/Attachments/" + attachmentId
		type :GET
		connection:"oauthconnection"
	];
	info fileResponse;
	fileResponse.setParamName("file");
	response = invokeurl
	[
		url :"https://www.zohoapis.in/crm/v7/files"
		type :POST
		files:fileResponse
		connection:"oauthconnection"
	];
	info response;
	fileupload = response.get("data");
	fileupload2 = fileupload.getJSON("details").getJSON("id");
	info fileupload2;
	fmp = Map();
	fmp.put("file_id",fileupload2);
	fileList = List();
	fileList.add(fmp);
	mp = Map();
	mp.put("File_Upload_new",fileList);
	update = zoho.crm.updateRecord("Contacts",577983000009145583,mp);
	info update;
}
}